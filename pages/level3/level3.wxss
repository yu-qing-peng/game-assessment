.game-canvas {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.game-canvas.inert {
  pointer-events: none;
}

.hud {
  gap: 4rpx;
  padding: 4rpx 6rpx;
}

.hud-item {
  padding: 0 2rpx;
}

.hud-label {
  font-size: 14rpx;
  letter-spacing: 1rpx;
}

.hud-value {
  font-size: 22rpx;
}
