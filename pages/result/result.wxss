.result-page {
  display: flex;
  align-items: center;
  justify-content: center;
}

.result-panel {
  width: 76%;
  max-height: 96%;
  padding: 14rpx 36rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  overflow-y: auto;
}

.result-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.level-name {
  font-size: 21rpx;
  font-weight: 800;
  color: #e6f1ff;
  letter-spacing: 3rpx;
}

.stars {
  display: flex;
  gap: 5rpx;
}

.star {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.12);
}

.star.on {
  color: #fbbf24;
  text-shadow: 0 0 20rpx rgba(251, 191, 36, 0.7);
}

.score-wrap {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.score-info {
  display: flex;
  flex-direction: column;
}

.score-label {
  font-size: 16rpx;
  color: #7b8bb0;
}

.score-line {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.score-value {
  font-size: 56rpx;
  font-weight: 900;
  color: #00e5ff;
  line-height: 1.1;
  text-shadow: 0 0 40rpx rgba(0, 229, 255, 0.5);
  font-variant-numeric: tabular-nums;
}

.grade {
  font-size: 28rpx;
  font-weight: 900;
}

.grade.S {
  color: #fbbf24;
  text-shadow: 0 0 24rpx rgba(251, 191, 36, 0.8);
}

.grade.A {
  color: #a78bfa;
  text-shadow: 0 0 24rpx rgba(167, 139, 250, 0.8);
}

.grade.B {
  color: #00e5ff;
  text-shadow: 0 0 24rpx rgba(0, 229, 255, 0.8);
}

.grade.C {
  color: #34d399;
  text-shadow: 0 0 24rpx rgba(52, 211, 153, 0.8);
}

.grade.D {
  color: #7b8bb0;
}

.best-wrap {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
}

.best-label {
  font-size: 15rpx;
  color: #7b8bb0;
}

.best-value {
  font-size: 24rpx;
  font-weight: 800;
  color: #fbbf24;
}

.new-record {
  font-size: 17rpx;
  color: #04121f;
  background: linear-gradient(90deg, #fbbf24, #f59e0b);
  padding: 4rpx 8rpx 4rpx 16rpx;
  border-radius: 18rpx;
  font-weight: 700;
}

.metrics {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx 36rpx;
}

.metric {
  flex: 1 1 40%;
  min-width: 40%;
}

.metric-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 6rpx;
}

.metric-label {
  font-size: 17rpx;
  color: #8b9cc4;
}

.metric-value {
  font-size: 21rpx;
  font-weight: 700;
  color: #e6f1ff;
  font-variant-numeric: tabular-nums;
}

.bar {
  height: 8rpx;
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.08);
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 4rpx;
  background: linear-gradient(90deg, #00e5ff, #a78bfa);
  box-shadow: 0 0 12rpx rgba(0, 229, 255, 0.6);
  transition: width 0.8s ease;
}

.btns {
  display: flex;
  gap: 32rpx;
  justify-content: center;
  margin-top: 10rpx;
}
