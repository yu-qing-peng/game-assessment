.game-canvas {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.game-canvas.inert {
  pointer-events: none;
}

.side-hint {
  position: absolute;
  top: 70rpx;
  z-index: 2;
  font-size: 16rpx;
  letter-spacing: 1rpx;
  padding: 4rpx 14rpx;
  border-radius: 18rpx;
  pointer-events: none;
  white-space: nowrap;
}

.side-left {
  left: 30rpx;
  color: rgba(0, 229, 255, 0.8);
  border: 1rpx solid rgba(0, 229, 255, 0.3);
  background: rgba(0, 229, 255, 0.08);
}

.side-right {
  right: 30rpx;
  color: rgba(167, 139, 250, 0.9);
  border: 1rpx solid rgba(167, 139, 250, 0.35);
  background: rgba(167, 139, 250, 0.1);
}

.hud-label {
  font-size: 14rpx;
  letter-spacing: 1rpx;
}

.hud-value {
  font-size: 22rpx;
}

.btn-pause {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: 28rpx;
  z-index: 20;
}
