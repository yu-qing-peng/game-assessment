.board {
  position: absolute;
  z-index: 1;
  display: flex;
  flex-wrap: wrap;
}

.cell {
  box-sizing: border-box;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.03);
}

.cell.t.shown {
  opacity: 1;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 0 26rpx rgba(0, 229, 255, 0.5), inset 0 0 20rpx rgba(0, 229, 255, 0.3);
}

.cell.t.filled {
  opacity: 1;
  border: 2rpx solid rgba(255, 255, 255, 0.85);
  box-shadow: 0 0 24rpx rgba(255, 255, 255, 0.25);
}

.mem-banner {
  position: absolute;
  z-index: 15;
  text-align: center;
  pointer-events: none;
}

.mem-pill {
  display: inline-block;
  padding: 5rpx 18rpx;
  font-size: 20rpx;
  font-weight: 900;
  color: #e9d5ff;
  letter-spacing: 3rpx;
  white-space: nowrap;
  border-radius: 30rpx;
  border: 1rpx solid rgba(167, 139, 250, 0.6);
  background: rgba(167, 139, 250, 0.14);
  box-shadow: 0 0 26rpx rgba(167, 139, 250, 0.45), inset 0 0 18rpx rgba(167, 139, 250, 0.18);
  text-shadow: 0 0 14rpx rgba(167, 139, 250, 0.95), 0 0 30rpx rgba(167, 139, 250, 0.6);
  animation: bannerPulse 1.2s ease-in-out infinite;
}

.play-hint {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 14rpx;
  z-index: 3;
  text-align: center;
  font-size: 14rpx;
  color: #7b8bb0;
  letter-spacing: 2rpx;
  pointer-events: none;
}

.slot {
  position: absolute;
  z-index: 1;
  box-sizing: border-box;
  border: 2rpx dashed rgba(123, 139, 176, 0.35);
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.02);
}

.drag-area {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 2;
}

.block {
  box-sizing: border-box;
  padding: 6rpx;
}

.block-face {
  width: 100%;
  height: 100%;
  border-radius: 14rpx;
  box-shadow: 0 0 22rpx rgba(0, 229, 255, 0.4);
  border: 2rpx solid rgba(255, 255, 255, 0.6);
}

.block.placed .block-face {
  box-shadow: 0 0 30rpx rgba(255, 255, 255, 0.5);
}

.block-check {
  position: absolute;
  right: 0;
  top: 0;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  font-size: 24rpx;
  color: #04121f;
  background: #34d399;
  border-radius: 50%;
  font-weight: 900;
}

.hud-label {
  font-size: 14rpx;
  letter-spacing: 1rpx;
}

.hud-value {
  font-size: 22rpx;
}
