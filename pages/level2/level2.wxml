<view class="page tech-bg">
  <view class="hud">
    <view class="btn-back" bindtap="goBack">← 返回</view>
    <view class="hud-item"><text class="hud-label">轮次</text><text class="hud-value">{{round}}/5</text></view>
    <view class="hud-item"><text class="hud-label">目标</text><text class="hud-value">{{targetCount}}</text></view>
    <view class="hud-item"><text class="hud-label">正确</text><text class="hud-value good">{{correct}}</text></view>
    <view class="hud-item"><text class="hud-label">错误</text><text class="hud-value bad">{{wrong}}</text></view>
    <view class="hud-item"><text class="hud-label">用时</text><text class="hud-value">{{time}}s</text></view>
    <view class="hud-item"><text class="hud-label">准确率</text><text class="hud-value">{{accuracy}}%</text></view>
  </view>

  <view class="board" style="left:{{gridX}}px;top:{{gridY}}px;width:{{gridSize}}px;height:{{gridSize}}px;">
    <view wx:for="{{cells}}" wx:key="index"
      class="cell {{item.target?'t':'e'}} {{item.show?'shown':''}} {{item.filled?'filled':''}}"
      style="{{item.style}}"></view>
  </view>

  <view class="slot" wx:for="{{slots}}" wx:key="id"
    style="left:{{item.x}}px;top:{{item.y}}px;width:{{blockSize}}px;height:{{blockSize}}px;"></view>

  <movable-area class="drag-area" style="width:{{W}}px;height:{{H}}px;">
    <movable-view wx:for="{{blocks}}" wx:key="id"
      class="block {{item.placed?'placed':''}}"
      direction="all"
      x="{{item.x}}"
      y="{{item.y}}"
      disabled="{{item.placed || phaseLocked}}"
      data-index="{{index}}"
      bindchange="onBlockMove"
      bindtouchend="onBlockDrop"
      style="width:{{blockSize}}px;height:{{blockSize}}px;">
      <view class="block-face" style="background:{{item.color}};"></view>
      <view class="block-check" wx:if="{{item.placed}}">✓</view>
    </movable-view>
  </movable-area>

  <view class="overlay" wx:if="{{state==='ready'}}">
    <view class="overlay-box panel">
      <text class="overlay-title">第二关 · 位置与颜色匹配</text>
      <text class="overlay-desc">先记住方格中彩色方块的位置\n颜色消失后，凭记忆把方块拖入正确格子\n颜色与位置完全正确才算成功\n共 5 轮，目标数量逐轮增加</text>
      <view class="btn-primary btn-start" bindtap="startGame">开始挑战</view>
    </view>
  </view>

  <view class="overlay-light" wx:if="{{state==='rounding'}}">
    <text class="round-banner">第 {{round}} 轮</text>
  </view>

  <view class="mem-banner" wx:if="{{state==='show'}}" style="top:{{gridY + gridSize + 10}}px;left:{{gridX}}px;width:{{gridSize}}px"><view class="mem-pill">记住位置！</view></view>

  <view class="play-hint" wx:if="{{state==='playing'}}">凭记忆放入正确位置</view>

  <view class="overlay-light" wx:if="{{state==='clear'}}">
    <text class="round-banner good-banner">本轮完成！</text>
  </view>

  <view class="overlay" wx:if="{{state==='over'}}">
    <view class="overlay-box panel">
      <text class="overlay-title">本关完成</text>
      <text class="overlay-score">{{finalScore}}</text>
      <view class="btn-primary btn-sm" bindtap="toResult">查看成绩</view>
      <view class="btn-ghost btn-sm" bindtap="doBack">返回首页</view>
    </view>
  </view>
</view>
